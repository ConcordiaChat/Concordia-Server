# Server port (default 3000)
PORT=3000

# PostgreSQL connection — only needed when running WITHOUT Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=concordia
DB_USER=concordia
DB_PASSWORD=changeme

# Federation this server trusts — tokens are verified locally against its
# JWKS endpoint (/.well-known/jwks.json). No shared secrets.
FEDERATION_URL=https://federation.concordiachat.com

# REQUIRED in production: this server's public origin. Clients request
# Federation tokens scoped to exactly this value (the JWT `aud` claim) —
# it must match the address users type into their client.
# Falls back to http://localhost:PORT for local development.
SERVER_PUBLIC_ORIGIN=https://chat.example.com

# CORS — set to your frontend origin in production (e.g. http://localhost:5173)
CLIENT_ORIGIN=*
